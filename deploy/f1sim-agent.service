# Apex generator agent — pulls queued race jobs from https://apex.shadster.dev/api and runs the pipeline.
# Install:  cp deploy/f1sim-agent.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#           systemctl --user enable --now f1sim-agent
# Logs:     journalctl --user -u f1sim-agent -f
# Secrets are read from files outside the repo (never committed).
[Unit]
Description=Apex F1 race generator agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/f1-sim/pipeline
EnvironmentFile=%h/.config/shadster/r2.env
EnvironmentFile=%h/.config/f1sim/agent.env
Environment=R2_BUCKET=mobbin-archive
Environment=R2_PREFIX=f1-sim
Environment=F1SIM_CACHE=%h/Projects/f1-sim/.cache
Environment=F1SIM_API=https://apex.shadster.dev/api
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Projects/f1-sim/pipeline/.venv/bin/python -m f1sim.agent
Restart=always
RestartSec=15
Nice=5

[Install]
WantedBy=default.target
