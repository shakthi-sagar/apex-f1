{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "f1-sim",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "apex.shadster.dev", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cdn" }],
  "durable_objects": {
    "bindings": [
      { "name": "JOBS", "class_name": "SeasonJobs" },
      { "name": "GENERATOR", "class_name": "Generator" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeasonJobs", "Generator"] }],
  "workflows": [{ "name": "f1-sim-generate-race", "binding": "GENERATE", "class_name": "GenerateRaceWorkflow" }],
  // Container mode (requires the Workers Paid plan): uncomment and set GENERATOR_MODE to "container".
  // "containers": [
  //   {
  //     "class_name": "Generator",
  //     "image": "../pipeline/Dockerfile",
  //     "image_build_context": "../pipeline",
  //     "instance_type": "standard-2",
  //     "max_instances": 3
  //   }
  // ],
  // Per-IP limit on "generate" requests (and stale-race rebuild triggers). Local dev runs without it.
  "ratelimits": [{ "name": "GEN_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
  // Versions this deploy expects. They MUST equal pipeline/f1sim/__init__.py (pipeline/tests/test_versions.py checks).
  // Secrets are never listed here: `wrangler secret put AGENT_TOKEN` / `GITHUB_DISPATCH_TOKEN` (see docs/OPERATIONS.md).
  "vars": {
    "R2_PREFIX": "f1-sim",
    "CDN_HOST": "cdn.shadster.dev",
    "SCHEMA_VERSION": "1",
    "PIPELINE_VERSION": "3",
    "CIRCUIT_VERSION": "4",
    "MAX_CONCURRENT_JOBS": "3",
    "GENERATOR_MODE": "github",
    "GITHUB_REPO": "shakthi-sagar/apex-f1",
    "GITHUB_WORKFLOW": "generate.yml",
    "GITHUB_REF": "main",
    "DAILY_DISPATCH_CAP": "150"
  }
}
