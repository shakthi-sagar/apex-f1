{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "f1-sim",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "apex.shadster.dev", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mobbin-archive" }],
  "durable_objects": {
    "bindings": [
      { "name": "JOBS", "class_name": "SeasonJobs" },
      { "name": "GENERATOR", "class_name": "Generator" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeasonJobs", "Generator"] }],
  "workflows": [{ "name": "f1-sim-generate-race", "binding": "GENERATE", "class_name": "GenerateRaceWorkflow" }],
  // Container mode (requires the Workers Paid plan): uncomment and set GENERATOR_MODE to "container".
  // "containers": [
  //   {
  //     "class_name": "Generator",
  //     "image": "../pipeline/Dockerfile",
  //     "image_build_context": "../pipeline",
  //     "instance_type": "standard-2",
  //     "max_instances": 3
  //   }
  // ],
  "vars": {
    "R2_PREFIX": "f1-sim",
    "PIPELINE_VERSION": "3",
    "MAX_CONCURRENT_JOBS": "3",
    "GENERATOR_MODE": "agent"
  }
}
